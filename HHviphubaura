local function clickText(targetTextKeywords)
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if not obj:IsDescendantOf(ScreenGui) then
            if obj:IsA("GuiObject") and obj.Visible and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0 then
                local contentText = ""
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    contentText = string.lower(obj.Text)
                else
                    contentText = string.lower(obj.Name)
                end

                for _, kw in ipairs(targetTextKeywords) do
                    if contentText:find(string.lower(kw)) then
                        local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                        local cx = pos.X + sz.X / 2 + inset.X
                        local cy = pos.Y + sz.Y / 2 + inset.Y
                        pcall(function()
                            VirtualInputManager:SendMouseMoveEvent(cx, cy, game)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                            task.wait(0.03)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                        end)
                        return true
                    end
                end
            end
        end
    end
    return false
end

