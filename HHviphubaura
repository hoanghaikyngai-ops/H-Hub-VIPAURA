    end
    for i, id in ipairs(playlistIDs) do
        local itemBtn = Instance.new("TextButton", PlaylistContainer)
        itemBtn.Size = UDim2.new(1, -4, 0, 22)
        itemBtn.BackgroundColor3 = (i == currentPlaylistIndex) and Color3.fromRGB(0, 100, 150) or Color3.fromRGB(25, 28, 38)
