local function simulateHeavyLagSpike(duration)
    local startTick = tick()
    while tick() - startTick < duration do
        local heavyTask = 0
        for i = 1, 450000 do heavyTask = heavyTask + math.sqrt(i) end
        RunService.Heartbeat:Wait()
    end
end

local isRunning = false
local OriginalFishingSpotCFrame = nil 

local function teleportAndRespawnAtIsland(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        simulateHeavyLagSpike(0.7)
        local isTeleporting = true
        local connection
        
        connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if not isTeleporting then return end
            isTeleporting = false
            if connection then connection:Disconnect() end
            
            task.spawn(function()
                local newRoot = newChar:WaitForChild("HumanoidRootPart", 5)
                local newHum = newChar:WaitForChild("Humanoid", 5)
                if newRoot and newHum then
                    newRoot.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                    simulateHeavyLagSpike(1.0)
                    
                    local lockStart = tick()
                    while tick() - lockStart < 17 do
                        pcall(function()
                            if newRoot and newHum then
                                newRoot.Anchored = true
                                newHum.WalkSpeed = 0
                                newRoot.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                            end
                        end)
                        task.wait(0.1)
                    end
                    
                    if isRunning then
                        OriginalFishingSpotCFrame = newRoot.CFrame
                        newRoot.Anchored = true
                        newHum.WalkSpeed = 0
                    else
                        OriginalFishingSpotCFrame = nil
                        newRoot.Anchored = false
                        newHum.WalkSpeed = 16
                    end
                end
            end)
        end)
        
        hum.Health = 0
    end)
end

