        {key = Enum.KeyCode.Z, index = 1, name = "Z"},
        {key = Enum.KeyCode.X, index = 2, name = "X"},
        {key = Enum.KeyCode.C, index = 3, name = "C"},
        {key = Enum.KeyCode.V, index = 4, name = "V"}
    }

    while ScreenGui.Parent do
        task.wait(0.4)
        if isRunning then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then return end
                
                if not OriginalFishingSpotCFrame and not isSellingFish then OriginalFishingSpotCFrame = root.CFrame end

                -- BÁN CÁ
                if getFishToSellCount() >= maxFishCapacity and not isSellingFish then
                    isSellingFish = true
                    
                    local vp = Workspace.CurrentCamera.ViewportSize
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1)
                    task.wait(0.08)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1)
                    task.wait(0.4)

                    root.Anchored = false
                    hum.WalkSpeed = 16
                    task.wait(0.1)

                    local dynamicMerchantPos = getMerchantPosition()
                    local dist = (root.Position - dynamicMerchantPos).Magnitude
                    local merchantTween = TweenService:Create(root, TweenInfo.new(dist / 60, Enum.EasingStyle.Linear), {CFrame = CFrame.new(dynamicMerchantPos + Vector3.new(0, 3, 3))})
                    merchantTween:Play()
                    while merchantTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.1) end
                    
                    root.CFrame = CFrame.lookAt(dynamicMerchantPos + Vector3.new(0, 2, 3), dynamicMerchantPos)
                    task.wait(0.5)

                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.08)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    task.wait(0.6)

                    repeat
                        if not isRunning then break end
                        clickBtn({"bán tất cả", "sell all", "bán", "sell", "confirm", "đồng ý"})
                        task.wait(1.0)
                    until getFishToSellCount() == 0 or not isRunning

                    if OriginalFishingSpotCFrame then
                        root.Anchored = false
                        hum.WalkSpeed = 16
                        local dBack = (root.Position - OriginalFishingSpotCFrame.Position).Magnitude
                        local backTween = TweenService:Create(root, TweenInfo.new(dBack / 60, Enum.EasingStyle.Linear), {CFrame = OriginalFishingSpotCFrame})
                        backTween:Play()
                        while backTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.1) end
                        root.CFrame = OriginalFishingSpotCFrame
                    end
                    
                    isSellingFish = false 
                end

                if not isRunning or isSellingFish then return end

                if OriginalFishingSpotCFrame then root.CFrame = OriginalFishingSpotCFrame end
                root.Anchored = true
                hum.WalkSpeed = 0

                local activeTool = char and char:FindFirstChildOfClass("Tool")
                local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))

                if not isHoldingRod then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                    task.wait(0.5)
                end

                if isHoldingRod and isRunning and not isSellingFish then
                    local vp = Workspace.CurrentCamera.ViewportSize
                    pcall(function() activeTool:Activate() end)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, true, game, 1)
                    task.wait(2)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, false, game, 1)

                    -- VÒNG CHỜ CÂU VÀ SPAM CHIÊU LUÔN TỪ KHI THẢ CẦN
                    local initialFishCount = getFishToSellCount()
                    local aStart = tick()

                    while tick() - aStart < 60 and isRunning and not isSellingFish do
                        solveMiniGameFast()
                        
                        -- SPAM Z, X, C, V LIÊN TỤC TRONG LÚC ĐỢI CÁ
                        if isAutoSkillOn then
                            pcall(function()
                                for _, skill in ipairs(skillsList) do
                                    if not isAutoSkillOn or not isRunning or isSellingFish then break end
                                    
                                    VirtualInputManager:SendKeyEvent(true, skill.key, false, game)
