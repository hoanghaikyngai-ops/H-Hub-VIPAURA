local function setCharacterNoClip(enabled)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = not enabled
                end
            end
        end
    end)
end

local function safeTweenToTarget(targetCFrame, travelSpeed)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    setCharacterNoClip(true)
    root.Anchored = false

    local dist = (root.Position - targetCFrame.Position).Magnitude
    local duration = math.max(dist / (travelSpeed or 55), 0.1)
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})

    tween:Play()

    local lastCheckPos = root.Position
    local stuckCounter = 0

    while tween.PlaybackState == Enum.PlaybackState.Playing and isRunning do
        task.wait(0.2)
        setCharacterNoClip(true)

        if (root.Position - lastCheckPos).Magnitude < 0.8 then
            stuckCounter = stuckCounter + 0.2
            if stuckCounter >= 1.2 then
                root.CFrame = root.CFrame + Vector3.new(0, 10, 0)
                stuckCounter = 0
            end
        else
            stuckCounter = 0
        end
        lastCheckPos = root.Position
    end

    setCharacterNoClip(false)
end

