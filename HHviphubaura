local isRunning = false
local OriginalFishingSpotCFrame = nil

local function teleportAndRespawnAtIsland(targetPos)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local isTeleporting = true
        local connection
        connection = LocalPlayer.CharacterAdded:Connect(function(newChar)
            if not isTeleporting then return end
            isTeleporting = false
            if connection then connection:Disconnect() end

            task.spawn(function()
                local newRoot = newChar:WaitForChild("HumanoidRootPart", 10)
                local newHum = newChar:WaitForChild("Humanoid", 10)
                
                if newRoot and newHum then
                    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                    newChar:PivotTo(targetCFrame)
                    newRoot.Anchored = false
                    newHum.WalkSpeed = 16

                    if isRunning then
                        OriginalFishingSpotCFrame = targetCFrame
                    else
                        OriginalFishingSpotCFrame = nil
                    end
                end
            end)
        end)
        hum.Health = 0
    end)
end

