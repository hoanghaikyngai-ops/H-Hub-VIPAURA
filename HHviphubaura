local initialFishCount = getFishToSellCount()
                    local sellStartTime = tick()

                    repeat
                        if not isRunning then break end
                        -- Vẫn giữ nguyên chức năng tự động ấn bán tất cả
                        clickBtn({"bán tất cả", "sell all", "bán", "sell", "confirm", "đồng ý"})
                        task.wait(0.6)

                        local currentFish = getFishToSellCount()
                        local fishSold = initialFishCount - currentFish

                        if fishSold > 2 or currentFish == 0 then
                            break
                        end
                    until (tick() - sellStartTime > 8) or not isRunning

                    task.wait(0.4)

                    -- Tự động tìm nút tạm biệt. liên tục trong 5 giây
                    local byeStartTime = tick()
                    repeat
                        if not isRunning then break end
                        local clicked = clickBtn({"tạm biệt.", "tam biet.", "tạm biệt", "tam biet", "goodbye", "thoát", "close", "đóng", "x", "back", "leave", "exit"})
                        if clicked then 
                            break 
                        end
                        task.wait(0.25)
                    until (tick() - byeStartTime > 5.0) or not isRunning
