-- 💃 LẮC HÔNG VÀ CẢ CHÂN NHỊP NHÀNG
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local upperTorso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        
        local rootJoint = rootPart and rootPart:FindFirstChild("RootJoint")
        local leftHip = upperTorso and (upperTorso:FindFirstChild("LeftHip") or char:FindFirstChild("Left Hip"))
        local rightHip = upperTorso and (upperTorso:FindFirstChild("RightHip") or char:FindFirstChild("Right Hip"))
        
        if rootJoint then
            if not originalRootC0 then originalRootC0 = rootJoint.C0 end
            if leftHip and not originalLeftHipC0 then originalLeftHipC0 = leftHip.C0 end
            if rightHip and not originalRightHipC0 then originalRightHipC0 = rightHip.C0 end
            
            if isHipSwayEnabled then
                local t = tick() * 2.5
                local hipX = math.sin(t) * 0.45
                local bounceY = math.abs(math.sin(t * 2)) * 0.12
                local angleZ = math.sin(t) * 0.35
                local angleY = math.cos(t * 0.5) * 0.2
                
                -- Lắc hông
                local swayCFrame = originalRootC0 * CFrame.new(hipX, bounceY, 0) * CFrame.Angles(0, angleY, angleZ)
                rootJoint.C0 = rootJoint.C0:Lerp(swayCFrame, 0.25)
                
                -- Lắc chân trái & chân phải đồng bộ để không bị cứng đờ
                if leftHip and originalLeftHipC0 then
                    local legSwayL = originalLeftHipC0 * CFrame.Angles(math.sin(t) * 0.2, 0, math.cos(t) * 0.15)
                    leftHip.C0 = leftHip.C0:Lerp(legSwayL, 0.25)
                end
                if rightHip and originalRightHipC0 then
                    local legSwayR = originalRightHipC0 * CFrame.Angles(-math.sin(t) * 0.2, 0, -math.cos(t) * 0.15)
                    rightHip.C0 = rightHip.C0:Lerp(legSwayR, 0.25)
                end
            else
                if originalRootC0 and rootJoint.C0 ~= originalRootC0 then
                    rootJoint.C0 = rootJoint.C0:Lerp(originalRootC0, 0.2)
                end
                if leftHip and originalLeftHipC0 and leftHip.C0 ~= originalLeftHipC0 then
                    leftHip.C0 = leftHip.C0:Lerp(originalLeftHipC0, 0.2)
                end
                if rightHip and originalRightHipC0 and rightHip.C0 ~= originalRightHipC0 then
                    rightHip.C0 = rightHip.C0:Lerp(originalRightHipC0, 0.2)
                end
            end
        end
    end)
end)

