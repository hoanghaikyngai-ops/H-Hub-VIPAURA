RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local rootJoint = char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("RootJoint")
        
        if rootJoint then
            if not originalRootC0 then originalRootC0 = rootJoint.C0 end
            
            if isHipSwayEnabled and bgSound.IsPlaying then
                local speedMult = 2.2 * (cortisolLevel * 0.2 + 0.8)
                local t = tick() * speedMult
                
                local angleZ = math.sin(t) * (0.12 * cortisolLevel)
                local angleY = math.cos(t * 0.5) * (0.08 * cortisolLevel)
                local bounceY = math.abs(math.sin(t)) * (0.05 * cortisolLevel)
                
                local swayCFrame = originalRootC0 * CFrame.new(0, bounceY, 0) * CFrame.Angles(0, angleY, angleZ)
                rootJoint.C0 = rootJoint.C0:Lerp(swayCFrame, 0.15)
            else
                if originalRootC0 and rootJoint.C0 ~= originalRootC0 then
                    rootJoint.C0 = rootJoint.C0:Lerp(originalRootC0, 0.1)
                end
            end
        end
    end)
end)

