RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        local upperTorso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        
        local rootJoint = rootPart and rootPart:FindFirstChild("RootJoint")
        local leftHip = upperTorso and (upperTorso:FindFirstChild("LeftHip") or char:FindFirstChild("Left Hip"))
        local rightHip = upperTorso and (upperTorso:FindFirstChild("RightHip") or char:FindFirstChild("Right Hip"))
        local leftShoulder = upperTorso and (upperTorso:FindFirstChild("LeftShoulder") or char:FindFirstChild("Left Shoulder"))
        local rightShoulder = upperTorso and (upperTorso:FindFirstChild("RightShoulder") or char:FindFirstChild("Right Shoulder"))
        
        if rootJoint then
            if not originalRootC0 then originalRootC0 = rootJoint.C0 end
            if leftHip and not originalLeftHipC0 then originalLeftHipC0 = leftHip.C0 end
            if rightHip and not originalRightHipC0 then originalRightHipC0 = rightHip.C0 end
            if leftShoulder and not originalLeftShoulderC0 then originalLeftShoulderC0 = leftShoulder.C0 end
            if rightShoulder and not originalRightShoulderC0 then originalRightShoulderC0 = rightShoulder.C0 end
            
            if isHipSwayEnabled then
                local t = tick() * 6.5
                local bodySwayX = math.sin(t * 2) * 0.25
                local bodySwayY = math.cos(t) * 0.35
                local bodySwayZ = math.sin(t) * 0.75
                
                local swayCFrame = originalRootC0 * CFrame.new(0, bodySwayY, 0) * CFrame.Angles(math.rad(bodySwayX * 20), 0, bodySwayZ)
                rootJoint.C0 = rootJoint.C0:Lerp(swayCFrame, 0.4)
                
                if leftHip and originalLeftHipC0 then
                    local legSwayL = originalLeftHipC0 * CFrame.Angles(math.sin(t) * 0.65, 0, -math.sin(t) * 0.5)
                    leftHip.C0 = leftHip.C0:Lerp(legSwayL, 0.4)
                end
                if rightHip and originalRightHipC0 then
                    local legSwayR = originalRightHipC0 * CFrame.Angles(-math.sin(t) * 0.65, 0, math.sin(t) * 0.5)
                    rightHip.C0 = rightHip.C0:Lerp(legSwayR, 0.4)
                end
                
                if leftShoulder and originalLeftShoulderC0 then
                    local handsOnHipsL = originalLeftShoulderC0 * CFrame.new(-0.25, 0.15, -0.35) * CFrame.Angles(math.rad(50), math.rad(-20), math.rad(-35))
                    leftShoulder.C0 = leftShoulder.C0:Lerp(handsOnHipsL, 0.4)
                end
                if rightShoulder and originalRightShoulderC0 then
                    local handsOnHipsR = originalRightShoulderC0 * CFrame.new(0.25, 0.15, -0.35) * CFrame.Angles(math.rad(50), math.rad(20), math.rad(35))
                    rightShoulder.C0 = rightShoulder.C0:Lerp(handsOnHipsR, 0.4)
                end
            else
                if originalRootC0 and rootJoint.C0 ~= originalRootC0 then rootJoint.C0 = rootJoint.C0:Lerp(originalRootC0, 0.3) end
                if leftHip and originalLeftHipC0 then leftHip.C0 = leftHip.C0:Lerp(originalLeftHipC0, 0.3) end
                if rightHip and originalRightHipC0 then rightHip.C0 = rightHip.C0:Lerp(originalRightHipC0, 0.3) end
                if leftShoulder and originalLeftShoulderC0 then leftShoulder.C0 = leftShoulder.C0:Lerp(originalLeftShoulderC0, 0.3) end
                if rightShoulder and originalRightShoulderC0 then rightShoulder.C0 = rightShoulder.C0:Lerp(originalRightShoulderC0, 0.3) end
            end
        end
    end)
end)

