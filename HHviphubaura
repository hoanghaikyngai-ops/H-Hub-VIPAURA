task.spawn(function()
    local skillsList = {
        {key = Enum.KeyCode.Z, index = 1, name = "Z"},
        {key = Enum.KeyCode.X, index = 2, name = "X"},
        {key = Enum.KeyCode.C, index = 3, name = "C"},
        {key = Enum.KeyCode.V, index = 4, name = "V"}
    }
    
    while ScreenGui.Parent do
        task.wait(0.2)
        if isAutoSkillOn then
            pcall(function()
                for _, skill in ipairs(skillsList) do
                    if not isAutoSkillOn then break end
                    
                    VirtualInputManager:SendKeyEvent(true, skill.key, false, game)
                    task.wait(0.04)
                    VirtualInputManager:SendKeyEvent(false, skill.key, false, game)
                    
                    local btn = markerButtons[skill.index]
                    local inset = GuiService:GetGuiInset()
                    local finalX, finalY
                    
                    if btn then
                        local pos = btn.AbsolutePosition
                        local sz = btn.AbsoluteSize
                        finalX = pos.X + sz.X / 2 + inset.X
                        finalY = pos.Y + sz.Y / 2 + inset.Y
                    else
                        local vp = Workspace.CurrentCamera.ViewportSize
                        finalX = vp.X / 2
                        finalY = vp.Y / 2
                    end
                    
                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 1)
                    task.wait(0.04)
                    VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 1)
                    
                    SkillStatus.Text = "Đang dùng chiêu: " .. skill.name .. " -> Chờ 2 giây..."
                    
                    local waitStart = tick()
                    while tick() - waitStart < 2.0 and isAutoSkillOn do
                        task.wait(0.1)
                    end
                end
            end)
        end
    end
end)

