                if getFishToSellCount() >= maxFishCapacity and not isSellingFish then
                    isSellingFish = true
                    
                    local vp = Camera.ViewportSize
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1)
                    task.wait(0.08)
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1)
                    task.wait(0.25)

                    root.Anchored = false
                    hum.WalkSpeed = 16
                    task.wait(0.05)

                    local dynamicMerchantPos = getMerchantPosition()
                    local merchantTargetCFrame = CFrame.new(dynamicMerchantPos)
                    local safeTargetPos = dynamicMerchantPos - (merchantTargetCFrame.LookVector * 3.5)
                    local dist = (root.Position - safeTargetPos).Magnitude
                    
                    if merchantLockConnection then merchantLockConnection:Disconnect() end
                    
                    merchantLockConnection = RunService.RenderStepped:Connect(function()
                        pcall(function()
                            local currentChar = LocalPlayer.Character
                            local currentRoot = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
                            local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")
                            if currentRoot and dynamicMerchantPos then
                                currentRoot.Anchored = true
                                if currentHum then currentHum.WalkSpeed = 0 end
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, dynamicMerchantPos)
                                currentRoot.CFrame = CFrame.lookAt(currentRoot.Position, Vector3.new(dynamicMerchantPos.X, currentRoot.Position.Y, dynamicMerchantPos.Z))
                            end
                        end)
                    end)

                    local merchantTween = TweenService:Create(root, TweenInfo.new(dist / 55, Enum.EasingStyle.Linear), {CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)})
                    merchantTween:Play()
                    while merchantTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                    
                    root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)
                    task.wait(0.3)

                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    task.wait(0.5)

                    local initialFishCount = getFishToSellCount()
                    local sellStartTime = tick()

                    repeat
                        if not isRunning then break end
                        
                        pcall(function()
                            root.Anchored = true
                            hum.WalkSpeed = 0
                            root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)
                        end)

                        clickBtn({"bán tất cả", "sell all", "bán", "sell"})
                        task.wait(0.25)
                        clickBtn({"xác nhận", "confirm", "đồng ý", "yes", "ok"})
                        task.wait(0.4)

                        local currentFish = getFishToSellCount()
                        local fishSold = initialFishCount - currentFish

                        if currentFish == 0 or fishSold > 0 then
                            task.wait(0.3)
                            break
                        end
                    until (tick() - sellStartTime > 8) or not isRunning

                    task.wait(0.4)

                    local byeStartTime = tick()
                    local successfullyClosed = false
                    repeat
                        if not isRunning then break end
                        
                        pcall(function()
                            root.Anchored = true
                            hum.WalkSpeed = 0
                        end)

                        local clicked = clickBtn({"tạm biệt.", "tam biet.", "tạm biệt", "tam biet", "goodbye", "bye", "thoát", "close", "đóng", "x", "leave"})
                        if clicked then 
                            successfullyClosed = true
                            task.wait(0.5)
                            break 
                        end
                        task.wait(0.25)
                    until (tick() - byeStartTime > 4.0) or not isRunning

                    if not successfullyClosed then task.wait(0.4) end

                    if merchantLockConnection then
                        merchantLockConnection:Disconnect()
                        merchantLockConnection = nil
                    end

                    if OriginalFishingSpotCFrame then
                        root.Anchored = false
                        hum.WalkSpeed = 16
                        local dBack = (root.Position - OriginalFishingSpotCFrame.Position).Magnitude
                        local backTween = TweenService:Create(root, TweenInfo.new(dBack / 55, Enum.EasingStyle.Linear), {CFrame = OriginalFishingSpotCFrame})
                        backTween:Play()
                        while backTween.PlaybackState == Enum.PlaybackState.Playing and isRunning do task.wait(0.05) end
                        root.CFrame = OriginalFishingSpotCFrame
                    end
                    
                    isSellingFish = false 
                end

                if not isRunning or isSellingFish or isFightingFish then return end

                if OriginalFishingSpotCFrame then root.CFrame = OriginalFishingSpotCFrame end
                root.Anchored = true
                hum.WalkSpeed = 0

                local activeTool = char and char:FindFirstChildOfClass("Tool")
                local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))

                if not isHoldingRod then
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
                    task.wait(0.02)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
                    task.wait(0.1)
                    activeTool = char and char:FindFirstChildOfClass("Tool")
                end

                if isRunning and not isSellingFish and not isFightingFish then
                    local vp = Camera.ViewportSize
                    if activeTool then pcall(function() activeTool:Activate() end) end
                    
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, true, game, 1)
                    
                    local holdStart = tick()
                    while tick() - holdStart < 2.0 and isRunning and not isSellingFish and not isFightingFish do
                        task.wait(0.05)
                    end
                    
                    VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2 - 80, 0, false, game, 1)
                    task.wait(0.05)
                end
            end)
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    originalRootC0 = nil
    originalLeftHipC0 = nil
    originalRightHipC0 = nil
    originalLeftShoulderC0 = nil
    originalRightShoulderC0 = nil
end)
