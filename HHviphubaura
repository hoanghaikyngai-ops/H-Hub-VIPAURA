local function getFish()
    local count = 0
    local function check(cont)
        if cont then
            for _, i in ipairs(cont:GetChildren()) do
                if i:IsA("Tool") then
                    local n = string.lower(i.Name)
                    if not (n:find("rod") or n:find("cần") or n:find("bait") or n:find("mồi") or n:find("potion") or n:find("license")) then
                        count = count + 1
                    end
                end
            end
        end
    end
    check(LocalPlayer.Backpack)
    check(LocalPlayer.Character)
    return count
end

