-- Bước 3: Định vị ProximityPrompt của NPC
local targetPrompt = nil
local targetPart = nil

for _, obj in pairs(Workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        local parent = obj.Parent
        if parent and parent:IsA("BasePart") then
            local parentName = string.lower(parent.Name)
            local distanceToMerchant = (parent.Position - CUSTOM_MERCHANT_POS).Magnitude
            local distanceToPlayer = (parent.Position - root.Position).Magnitude
            if (parentName:find("merchant") or parentName:find("fish") or parentName:find("sell") or parentName:find("fishmonger")) and distanceToMerchant < 25 and distanceToPlayer < 6 then
                targetPrompt = obj; targetPart = parent; break
            end
        end
    end
end

-- Bước 4: Đi sát và xoay mặt thẳng vào NPC
if targetPart then
    local npcPos = targetPart.Position
    root.CFrame = CFrame.new(npcPos + Vector3.new(0, 0, 2), npcPos)
    task.wait(0.2)
end

root.Anchored = true; hum.WalkSpeed = 0
