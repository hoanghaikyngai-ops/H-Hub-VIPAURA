-- HÀM SPAM CLICK RIÊNG CHO NÚT TẠM BIỆT TRONG 3 GIÂY
-- =========================================================
local function triggerIndependentByeLoop()
    local byeKeywords = {"tạm biệt", "tam biet", "goodbye", "bye", "thoát", "close", "đóng", "x"}
    local startTime = tick()
    
    while (tick() - startTime < 3.0) and isRunning do
        local clicked = clickText(byeKeywords)
        task.wait(0.1)
    end
end

-- =========================================================
-- HÀM QUÉT CÁ TRONG BÁN KÍNH 90 STUDS
-- =========================================================
local function getTargetFishPosition2D()
    if isSellingFish then return nil end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestDist = math.huge
    local targetScreenPos = nil

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and (obj:IsA("Model") or obj:IsA("BasePart")) and obj ~= char then
            local name = string.lower(obj.Name)
            if name:find("fish") or name:find("cá") or name:find("mob") or name:find("target") or name:find("bobber") then
                local part = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart"))
                if part then
                    local dist = (part.Position - root.Position).Magnitude
                    if dist <= 90 and dist < closestDist then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            closestDist = dist
                            targetScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                        end
                    end
                end
            end
        end
    end
    return targetScreenPos
end

