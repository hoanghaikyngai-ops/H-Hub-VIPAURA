local function updateHeadBillboard()
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild("Head")
    if not isHipSwayEnabled or not head then
        if headBillboard then headBillboard:Destroy(); headBillboard = nil end
        return
    end
    if not headBillboard then
        headBillboard = Instance.new("BillboardGui")
        headBillboard.Size = UDim2.new(0, 210, 0, 115)
        headBillboard.StudsOffset = Vector3.new(0, 4.0, 0)
        headBillboard.AlwaysOnTop = true
        headBillboard.Parent = head
