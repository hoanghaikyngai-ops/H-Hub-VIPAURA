-- =========================================================
-- VÒNG LẶP CÂU CÁ & BÁN CÁ CHÍNH
-- =========================================================
task.spawn(function()
    while ScreenGui.Parent do
        task.wait(0.02)
        if isRunning and not isSellingFish then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum then
                if not OriginalFishingSpotCFrame then OriginalFishingSpotCFrame = root.CFrame end

                -- TỰ ĐỘNG BÁN CÁ KHI ĐỦ NGƯỠNG
                if getFishToSellCount() >= maxFishCapacity and not isSellingFish then
                    isSellingFish = true
                    
                    local vp = Camera.ViewportSize
                    pcall(function()
                        VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 1); task.wait(0.08)
                        VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 1); task.wait(0.25)
                    end)

                    root.Anchored = false; hum.WalkSpeed = 0; task.wait(0.05)

                    local dynamicMerchantPos = getMerchantPosition()
                    local safeTargetPos = dynamicMerchantPos - (CFrame.new(dynamicMerchantPos).LookVector * 3.5)
                    
                    if merchantLockConnection then merchantLockConnection:Disconnect() end

                    merchantLockConnection = RunService.RenderStepped:Connect(function()
                        pcall(function()
                            local cc = LocalPlayer.Character
                            local cr = cc and cc:FindFirstChild("HumanoidRootPart")
                            local ch = cc and cc:FindFirstChildOfClass("Humanoid")
                            if cr and dynamicMerchantPos then
                                cr.Anchored = false; if ch then ch.WalkSpeed = 0 end
                                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, dynamicMerchantPos)
                                cr.CFrame = CFrame.lookAt(cr.Position, Vector3.new(dynamicMerchantPos.X, cr.Position.Y, dynamicMerchantPos.Z))
                            end
                        end)
                    end)

                    safeTweenToTarget(CFrame.new(safeTargetPos, dynamicMerchantPos), 55)
                    
                    root.Anchored = false
                    root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)
                    task.wait(0.35)

                    -- BẮT ĐẦU MỞ THOẠI MERCHANT BẰNG PHÍM E
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game); task.wait(0.08)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game); task.wait(0.5)
                    end)

                    local initialFishCount = getFishToSellCount()
                    local sellStartTime = tick()
                    local state = "BAN_TAT_CA"

                    repeat
                        if not isRunning then break end

                        pcall(function()
                            root.Anchored = false
                            hum.WalkSpeed = 0
                            root.CFrame = CFrame.new(safeTargetPos, dynamicMerchantPos)
                        end)

                        local currentFishCount = getFishToSellCount()

                        -- ĐIỀU KIỆN CHUYỂN NGAY SANG LUỒNG TẠM BIỆT: Cá giảm số lượng HOẶC dưới 2 con
                        if (currentFishCount < initialFishCount) or (currentFishCount <= 2) then
                            state = "TAM_BIET"
                        end

                        if state == "BAN_TAT_CA" then
                            clickText({"bán tất cả", "sell all", "bán hết", "sell"})
                            task.wait(0.3)
                            state = "XAC_NHAN"

                        elseif state == "XAC_NHAN" then
                            clickText({
                                "xác nhận bán tất cả",
                                "xac nhan ban tat ca",
                                "xác nhận",
                                "xac nhan",
                                "confirm",
                                "yes"
                            })
                            task.wait(0.3)

                        elseif state == "TAM_BIET" then
                            -- KÍCH HOẠT LUỒNG QUÉT C LICK TẠM BIỆT ĐỘC LẬP TRONG 3 GIÂY
                            triggerIndependentByeLoop()
                            break
                        end

                        task.wait(0.15)
                    until (tick() - sellStartTime > 12) or not isRunning

                    if merchantLockConnection then merchantLockConnection:Disconnect(); merchantLockConnection = nil end

                    task.wait(0.5)

                    pcall(function() hum.Jump = true end)
                    task.wait(0.2)

                    -- DỊCH CHUYỂN QUAY VỀ ĐIỂM CÂU
                    if OriginalFishingSpotCFrame then
                        root.Anchored = false; hum.WalkSpeed = 16
                        
                        safeTweenToTarget(OriginalFishingSpotCFrame, 55)
                        
                        pcall(function()
                            char:PivotTo(OriginalFishingSpotCFrame)
                            root.CFrame = OriginalFishingSpotCFrame
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                        end)

                        pcall(function()
                            Camera.CameraType = Enum.CameraType.Scriptable
                            local targetLook = OriginalFishingSpotCFrame.LookVector
                            local headPos = (char:FindFirstChild("Head") or root).Position
                            local camPos = headPos - (targetLook * 10) + Vector3.new(0, 3, 0)
                            
                            local camTween = TweenService:Create(Camera, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                CFrame = CFrame.lookAt(camPos, headPos + (targetLook * 5))
                            })
                            camTween:Play()
                            camTween.Completed:Wait()
                            Camera.CameraType = Enum.CameraType.Custom
                        end)

                        root.Anchored = false
                        task.wait(0.5)
                    end
                    
                    isSellingFish = false
                    continue
                end

                pcall(function()
                    root.CFrame = OriginalFishingSpotCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
                hum.WalkSpeed = 0

                local currentFishPos = getTargetFishPosition2D()

                if currentFishPos then
                    local offsets = {
                        Vector2.new(0, 0),    -- Tâm
                        Vector2.new(0, -32),  -- Trên (-32px)
                        Vector2.new(-90, 0),  -- Trái (-90px)
                        Vector2.new(90, 0)    -- Phải (+90px)
                    }

                    for _, offset in ipairs(offsets) do
                        if not isRunning or isSellingFish then break end
                        local latestPos = getTargetFishPosition2D() or currentFishPos
                        if not latestPos then break end
                        local targetClickPos = latestPos + offset

                        pcall(function()
                            VirtualInputManager:SendMouseMoveEvent(targetClickPos.X, targetClickPos.Y, game)
                            VirtualInputManager:SendMouseButtonEvent(targetClickPos.X, targetClickPos.Y, 0, true, game, 1)
                            task.wait(0.005)
                            VirtualInputManager:SendMouseButtonEvent(targetClickPos.X, targetClickPos.Y, 0, false, game, 1)
                        end)
                        task.wait(0.005)
                    end
                else
                    local activeTool = char and char:FindFirstChildOfClass("Tool")
                    local isHoldingRod = activeTool and (string.lower(activeTool.Name):find("rod") or string.lower(activeTool.Name):find("cần"))
                    
                    if not isHoldingRod then
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game); task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game); task.wait(0.1)
                        end)
                    end

                    local vp = Camera.ViewportSize
                    local centerPos = Vector2.new(vp.X / 2, vp.Y / 2)

                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(centerPos)
                        VirtualInputManager:SendMouseMoveEvent(centerPos.X, centerPos.Y, game)
                        VirtualInputManager:SendMouseButtonEvent(centerPos.X, centerPos.Y, 0, true, game, 1)
                    end)

                    local holdStart = tick()
                    while (tick() - holdStart < 1.8) and isRunning and not isSellingFish do
                        if getTargetFishPosition2D() then break end
                        activeTool = char and char:FindFirstChildOfClass("Tool")
                        if activeTool then pcall(function() activeTool:Activate() end) end
                        task.wait(0.04)
                    end

                    pcall(function()
                        VirtualUser:Button1Up(centerPos)
                        VirtualInputManager:SendMouseButtonEvent(centerPos.X, centerPos.Y, 0, false, game, 1)
                    end)
                    task.wait(0.1)
                end
            end
        end
    end
end)

-- ================= VÒNG LẶP RENDER =================
RunService.RenderStepped:Connect(function()
    pcall(function()
        updateHeadBillboard()
        local timeVal = tick() * 2
        local neonColor = Color3.fromRGB(
            math.floor(math.sin(timeVal) * 35 + 35),
            math.floor(math.sin(timeVal) * 110 + 145), 255
        )
        MainStroke.Color = neonColor
        CenterStroke.Color = neonColor
        MusicBarStroke.Color = neonColor
        ToggleStroke.Color = neonColor
        TopGlow.BackgroundColor3 = neonColor

        if bgSound and bgSound.IsPlaying and bgSound.TimeLength > 0 and currentProgressBar then
            local percent = math.clamp(bgSound.TimePosition / bgSound.TimeLength, 0, 1)
            currentProgressBar.Size = UDim2.new(percent, 0, 1, 0)
        end

        local char = LocalPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        local rootJoint = rootPart and rootPart:FindFirstChild("RootJoint")

        if rootJoint and isHipSwayEnabled then
            local t = tick() * 6.5
            local bodySwayX = math.sin(t * 2) * 0.25
            local bodySwayY = math.cos(t) * 0.35
            local bodySwayZ = math.sin(t) * 0.75
            rootJoint.C0 = rootJoint.C0:Lerp(CFrame.new(0, bodySwayY, 0) * CFrame.Angles(math.rad(bodySwayX * 20), 0, bodySwayZ), 0.4)
        end
    end)
end)
