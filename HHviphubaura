local function getMerchantPosition()
    local targetName = "merchant fish"
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and (obj:IsA("Model") or obj:IsA("Part")) then
            if string.lower(obj.Name):find(targetName) then
                local primaryPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildOfClass("Part")) or obj
                if primaryPart and primaryPart:IsA("BasePart") then return primaryPart.Position end
            end
        end
    end
    return Vector3.new(1263.48, 27.71, -349.61)
end

local function clickBtn(keys)
    local inset = GuiService:GetGuiInset()
    for _, obj in pairs(PlayerGui:GetDescendants()) do
        if obj and obj.Parent and not obj:IsDescendantOf(ScreenGui) then
            if (obj:IsA("TextButton") or obj:IsA("TextLabel")) and obj.Visible then
                local txt = string.lower(obj.Text or "")
                for _, kw in ipairs(keys) do
                    if txt:find(kw) then
                        local pos, sz = obj.AbsolutePosition, obj.AbsoluteSize
                        local cx, cy = pos.X + sz.X/2 + inset.X, pos.Y + sz.Y/2 + inset.Y
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local cachedDamageRemotes = {}
local isRemoteSearched = false

local function findAndCacheRemotes()
    if isRemoteSearched then return end
    isRemoteSearched = true
    task.spawn(function()
        for _, remote in pairs(game:GetDescendants()) do
            if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                local rName = string.lower(remote.Name)
                if rName:find("damage") or rName:find("hit") or rName:find("fish") or rName:find("catch") or rName:find("reel") or rName:find("progress") then
                    table.insert(cachedDamageRemotes, remote)
                end
            end
        end
    end)
end
findAndCacheRemotes()

local function solveMiniGameFast()
    local inset = GuiService:GetGuiInset()
    pcall(function()
        for _, obj in pairs(PlayerGui:GetDescendants()) do
            if obj and obj.Parent and not obj:IsDescendantOf(ScreenGui) and obj.Visible then
                local n = string.lower(obj.Name)
                if n:find("bar") or n:find("progress") or n:find("fill") then
                    if obj:IsA("Frame") or obj:IsA("ImageLabel") then
                        pcall(function() obj.Size = UDim2.new(1, 0, obj.Size.Y.Scale, obj.Size.Y.Offset) end)
                    end
                end
                if n:find("minigame") or n:find("progress") or n:find("container") or n:find("bar") then
                    for _, child in pairs(obj:GetDescendants()) do
                        if child.Visible and (child:IsA("TextButton") or child:IsA("ImageButton") or child:IsA("Frame")) then
                            local sz = child.AbsoluteSize
                            local pos = child.AbsolutePosition
                            if sz.X > 5 and sz.X < 300 and sz.Y > 5 and sz.Y < 300 then
                                local cx = pos.X + sz.X / 2 + inset.X
                                local cy = pos.Y + sz.Y / 2 + inset.Y
                                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                                task.wait(0.001)
                                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function triggerServerDamageMultiplier()
    pcall(function()
        for _, remote in ipairs(cachedDamageRemotes) do
            if remote and remote.Parent then
                pcall(function() remote:FireServer(250) end)
                pcall(function() remote:FireServer("damage", 250) end)
                pcall(function() remote:FireServer(100) end)
            end
        end
    end)
end

