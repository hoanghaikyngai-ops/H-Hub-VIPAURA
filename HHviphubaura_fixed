local CS = game:GetService("CollectionService")
local plr = game:GetService("Players").LocalPlayer
local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
assert(root, "Chưa có nhân vật")
 
local function fmt(v)
	return string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
end
 
local function posOf(o)
	if o:IsA("Model") then return o:GetPivot().Position end
	if o:IsA("BasePart") then return o.Position end
end
 
-- ID đảo hiện tại (theo vùng IslandRegion chứa vị trí của bạn)
local islandId = ""
for _, r in ipairs(CS:GetTagged("IslandRegion")) do
	if r:IsA("BasePart") then
		local p = r.CFrame:PointToObjectSpace(root.Position)
		if math.abs(p.X) <= r.Size.X / 2 and math.abs(p.Z) <= r.Size.Z / 2 then
			islandId = r:GetAttribute("islandId") or ""
			break
		end
	end
end
 
-- Tìm Boat Merchant gần bạn nhất
local best, bestDist, bestPos
for _, v in ipairs(CS:GetTagged("Interactive")) do
	if v:GetAttribute("InteractiveId") == "npc_car_merchant" then
		local p = posOf(v)
		if p then
			local d = (p - root.Position).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist, bestPos = v, d, p
			end
		end
	end
end
 
local out = {}
local function line(s) table.insert(out, s) print(s) end
 
line("== Island ID hiện tại: " .. (islandId ~= "" and islandId or "(không xác định)"))
local id = best and best:GetAttribute("IslandId") or islandId
if best then
	line(string.format("== Boat Merchant: IslandId=%s, cách bạn %.0f stud", tostring(id), bestDist))
	if islandId ~= "" and id ~= islandId then
		line("!! Cảnh báo: merchant này thuộc đảo khác, hãy tới gần NPC của đảo mới rồi chạy lại")
	end
else
	line("!! Không thấy Boat Merchant. Đi lại gần NPC (để map stream) rồi chạy lại.")
end
line("")
line("-- 1) Dán ĐẦU script (override toạ độ NPC):")
line('getgenv().HoanghaiHubMerchantOverrides = { ["' .. tostring(id) .. '"] = ' .. (bestPos and fmt(bestPos) or "nil --[[chưa tìm thấy]]") .. " }")
line("")
line("-- 2) (Tuỳ chọn) dòng thêm vào bảng tbl22 (vị trí NPC):")
line('["' .. tostring(id) .. '"] = ' .. (bestPos and fmt(bestPos) or "nil") .. ",")
line("")
line("-- 3) (Tuỳ chọn) dòng thêm vào bảng toạ độ hạ cánh (đứng chỗ bạn đang đứng):")
line('["' .. tostring(id) .. '"] = ' .. fmt(root.Position) .. ",")
 
if setclipboard then
	pcall(setclipboard, table.concat(out, "\n"))
	print("(Đã copy vào clipboard)")
end
